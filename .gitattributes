# Was nicht zur Laufzeit gebraucht wird, bleibt aus `git archive` draußen.
# Das Archiv ist das, was /plugin install und die Agent-Skills-CLI holen.

__pycache__/   export-ignore
node_modules/  export-ignore
*.pyc          export-ignore
.DS_Store      export-ignore

# Mit führendem / greifen die Muster nur im Wurzelordner. Ohne / würde `assets/`
# auch skills/schnitt/assets/ (LUTs, augen.swift) aus dem Paket werfen.
/tests/        export-ignore
/docs/         export-ignore
/assets/       export-ignore
/.agents/      export-ignore
/.github/      export-ignore

.gitignore     export-ignore
.gitattributes export-ignore

# hooks/ und .claude-plugin/ bleiben bewusst drin: /plugin install holt das
# ganze Archiv und braucht beide.
