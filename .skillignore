.venv/
__pycache__/
*.pyc
*.log
.DS_Store
.pytest_cache/
node_modules/
out/

# Repo automation and host-specific packaging
.github/
.agents/
.claude-plugin/
hooks/

# Non-runtime docs, assets, and tests
tests/
assets/
README.md
CHANGELOG.md
AGENTS.md
CLAUDE.md
